  "ygs_glossary_title": "Glossary",
  "ygs_glossary_desc": "Plain-language explanations of common cycle terms.",
  "ygs_gloss_cycle": "Cycle",
  "ygs_gloss_cycle_def": "A menstrual cycle is the monthly process your body goes through, starting on the first day of your period and ending the day before your next period begins.",
  "ygs_gloss_cycle_more": "Cycles typically last between 21 and 35 days. Shorter or longer cycles are common, especially in the first few years.",
  "ygs_gloss_ovulation": "Ovulation",
  "ygs_gloss_ovulation_def": "Ovulation is when one of your ovaries releases a small egg. It usually happens roughly in the middle of your cycle.",
  "ygs_gloss_ovulation_more": "You may not notice any signs, but some people feel a mild twinge or notice a change in discharge around this time.",
  "ygs_gloss_spotting": "Spotting",
  "ygs_gloss_spotting_def": "Spotting is light bleeding that appears as small brown or pink marks between periods.",
  "ygs_gloss_spotting_more": "Spotting can be normal in the first years of having periods, or around ovulation. If you are ever unsure, it is always okay to talk to a trusted adult.",
  "ygs_glossary_disclaimer": "Definitions are for educational purposes only and are not medical advice.",
  "ygs_phases_title": "Cycle Phases",
  "ygs_phases_desc": "A typical 28-day cycle has four main phases. Your own cycle may be shorter or longer.",
  "ygs_phases_aria": "Diagram showing the four phases of a menstrual cycle as a colour-coded ring",
  "ygs_phases_center": "Cycle",
