  "ygs_phases_varies": "Every cycle is unique — timing and length can vary from month to month.",
  "ygs_hygiene_title": "How-To Guides",
  "ygs_howto_underwear_tab": "Period Underwear",
  "ygs_howto_cup_tab": "Period Cup",
  "ygs_howto_underwear_title": "How to Wash Period Underwear",
  "ygs_howto_underwear_step1": "Rinse under cool running water as soon as possible after use.",
  "ygs_howto_underwear_step2": "Hand-wash or machine-wash with a gentle, fragrance-free detergent.",
  "ygs_howto_underwear_step3": "Avoid fabric softener and bleach — they can damage the absorbent layers.",
  "ygs_howto_underwear_step4": "Air-dry flat or hang to dry. Avoid tumble-drying on high heat.",
  "ygs_howto_cup_title": "Period Cup Basics",
  "ygs_howto_cup_step1": "Wash your hands thoroughly before handling the cup.",
  "ygs_howto_cup_step2": "Fold the cup and insert it gently, following the instructions included with your specific product.",
  "ygs_howto_cup_step3": "Empty and rinse the cup every 4–12 hours as directed by the product instructions.",
  "ygs_howto_cup_step4": "Sterilise the cup in boiling water at the end of each cycle, as directed by the manufacturer.",
  "ygs_howto_cup_caution": "Stop use and speak with a trusted adult or clinician if you experience persistent pain, discomfort, or unusual symptoms.",
  "ygs_howto_disclaimer": "Educational guide only. Always follow the instructions provided with your product and consult a clinician if unsure.",
